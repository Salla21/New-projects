# The Smiling Coast Hub — Environment Variables
# Copy this file to .env.local and fill in values as needed.

# Base URL for the deployed site (used for SEO/OG metadata)
# Example: https://thesmilingcoasthub.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: YouTube Data API v3 key (Phase 2 — video content ingestion)
# Used to fetch video metadata from Gambian YouTube channels
# Get a key at: https://console.cloud.google.com/apis/credentials
# NEXT_PUBLIC_YOUTUBE_API_KEY=

# Optional: Analytics tracking ID (leave empty to disable)
# NEXT_PUBLIC_ANALYTICS_ID=

# Optional: Contact form endpoint (if using a third-party form service)
# NEXT_PUBLIC_CONTACT_FORM_URL=
